{
  "_comment": "إعدادات مشروع Limog_elec. كل القيم هنا قابلة للتعديل؛ القيم المعلَّمة TODO افتراضات يجب مراجعتها.",

  "units_to_m": null,

  "sheets": {
    "frame_block": "Frame A3",
    "title_regex": "^(?P<floor>.+?)\\s+LIGHTING$",
    "title_layers": ["E-ELEC TEXT"]
  },

  "layers": {
    "room_boundary": ["A-ROOM"],
    "room_tag": ["A-ROOM-TAG", "ARC BASEM"],
    "walls": ["ARC BASEM"],
    "wall_exclude_blocks_regex": "^(yq_|A\\$C)",
    "egress": ["E-EGRESS"]
  },

  "room_detection": {
    "pixel_m": 0.05,
    "seal_gap_m": 0.15,
    "max_room_area_m2": 150,
    "min_room_area_m2": 1.0,
    "seed_unlabelled_rooms_from_luminaires": true
  },

  "geometry_defaults": {
    "ceiling_height_m": 3.0,
    "work_plane_m": 0.8,
    "wall_band_m": 0.5,
    "ceiling_height_regex": "\\bH\\s*=\\s*(?P<h>\\d+(?:\\.\\d+)?)"
  },

  "surfaces": {
    "rho_ceiling": 0.7,
    "rho_walls": 0.5,
    "rho_floor": 0.2
  },

  "maintenance_factor": 0.8,

  "luminaire_catalog": "catalog_limog.json",
  "rules": "rules_egypt.json"
}
